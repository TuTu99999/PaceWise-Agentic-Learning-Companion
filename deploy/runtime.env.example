# Copy once to /opt/pacewise/runtime.env on EC2 and replace every CHANGE_ME.
# This file is an example only. Never commit the real runtime.env.
# Permissions on EC2: sudo chown root:root /opt/pacewise/runtime.env && sudo chmod 600 /opt/pacewise/runtime.env

# Temporary single-EC2 demo mode. Move these values to Secrets Manager and set
# APP_ENV=production only after S3, KMS, SQS and remote Qdrant are ready.
APP_ENV=development
AWS_REGION=ap-southeast-1
APP_TIMEZONE=Asia/Ho_Chi_Minh
INSTITUTION_ID=university-x

PACEWISE_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
PACEWISE_API_KEY=CHANGE_ME_LONG_RANDOM_SERVICE_KEY
PACEWISE_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
METRICS_BEARER_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS

DATABASE_SCHEMA_REVISION=20261015_01
COURSE_SOURCE_MODE=standalone
COURSE_STORAGE_BACKEND=local
VECTOR_STORE_TYPE=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_PATH=
CHROMA_PERSIST_DIR=
RAG_WARM_ON_STARTUP=true

# Use a hosted HTTPS provider endpoint. OPENAI_API_KEY is loaded separately
# from AWS Secrets Manager into /opt/pacewise/secrets.env during deployment.
# Never store that key in runtime.env.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=CHANGE_ME_PROVIDER_MODEL
LLM_FAST_MODEL=CHANGE_ME_FAST_MODEL
LLM_REASONING_MODEL=CHANGE_ME_REASONING_MODEL

# Shared per-account AI quota. All /chat workflows (QA, Plan, Do, Reflect,
# Recover and Understanding) debit their observed input + output tokens here.
AI_RATE_LIMIT_ENABLED=true
AI_IP_REQUESTS_PER_MINUTE=1000
AI_BURST_REQUESTS=3
AI_BURST_WINDOW_SECONDS=10
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_HOUR=60
AI_DAILY_TOKEN_LIMIT_PER_USER=2000000
AI_ESTIMATED_TOKENS_PER_REQUEST=8000
AI_MAX_CONCURRENT_PER_USER=1
AI_MAX_CONCURRENT_GLOBAL=10
AI_RESERVATION_TTL_SECONDS=600
AI_DAILY_BUDGET_USD=0
AI_INSTITUTION_DAILY_BUDGET_USD=0

# Replace with the Elastic IP or HTTPS domain used by the browser.
CORS_ORIGINS=http://CHANGE_ME_PUBLIC_HOST
PACEWISE_URL=http://CHANGE_ME_PUBLIC_HOST
SESSION_COOKIE_SECURE=false
FORCE_HTTPS=false
PRIVATE_API_REQUIRED=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12

# Enable only after configuring the Google OAuth client for the deployed URL.
GOOGLE_SIGNUP_ENABLED=true
GOOGLE_SIGNUP_AUTO_ENROLL_COURSES=true
GOOGLE_SIGNUP_AUTO_ENROLL_TEACHER_EMAIL=teacher1@pacewise.edu.vn
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_REDIRECT_URI=http://CHANGE_ME_PUBLIC_HOST/api/v1/integrations/google-calendar/callback
GOOGLE_OAUTH_SUCCESS_URL=http://CHANGE_ME_PUBLIC_HOST/app#/settings

WEBPUSH_ENABLED=false
LOG_LEVEL=INFO
