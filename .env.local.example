# Copy to .env.local for local development only. Never commit .env.local.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://pacewise:pacewise-local-only@localhost:5433/pacewise
COURSE_SOURCE_MODE=standalone
COURSE_STORAGE_BACKEND=local
COURSE_UPLOAD_DIR=./data/course-source/uploads
COURSE_MOCK_FILE_DIR=./data/course-source/mock-files
QDRANT_URL=http://localhost:6333
QDRANT_PATH=./data/qdrant
CORS_ORIGINS=http://localhost:5173
PACEWISE_SESSION_SECRET=development-only-change-this-session-secret
SESSION_COOKIE_SECURE=false
FORCE_HTTPS=false
OPENAI_API_KEY=
