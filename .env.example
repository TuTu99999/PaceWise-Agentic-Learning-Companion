# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# For a model proxy on the Windows host while PaceWise runs in Docker, use:
# OPENAI_BASE_URL=http://host.docker.internal:20128/v1
MODEL_NAME=cx/gpt-5.6-luna
SEMANTIC_SAFETY_MODE=signals
RAG_SCORE_THRESHOLD=0.72
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=800
QA_MAX_OUTPUT_TOKENS=450
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql+psycopg://pacewise:change-me@localhost:5433/pacewise
DATABASE_SCHEMA_REVISION=
PACEWISE_DB_PASSWORD=change-me
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
VECTOR_STORE_TYPE=qdrant
# Docker Compose overrides this with http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Embedded fallback for minimal local/test runs when QDRANT_URL is empty.
QDRANT_PATH=./data/qdrant
EMBEDDING_CACHE_DIR=./data/models/fastembed
EMBEDDING_THREADS=1
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
RERANKER_CACHE_DIR=./data/models/flashrank

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
INSTITUTION_ID=university-x
APP_TIMEZONE=Asia/Ho_Chi_Minh
AWS_REGION=ap-southeast-1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
MAX_REQUEST_BODY_MB=55
READINESS_TIMEOUT_SECONDS=2
# ---- Canvas LMS simulator integration ----
LMS_BASE_URL=http://127.0.0.1:8010
COURSE_SOURCE_MODE=standalone
# Production must use s3; local is development-only until the S3 storage adapter is enabled.
COURSE_STORAGE_BACKEND=local
COURSE_UPLOAD_DIR=./data/course-source/uploads
COURSE_MOCK_FILE_DIR=./data/course-source/mock-files
S3_COURSE_MATERIALS_BUCKET=
S3_KMS_KEY_ID=
COURSE_PDF_MAX_MB=50
COURSE_PDF_MAX_PAGES=1000
COURSE_FILE_MAX_CHUNKS=2000
COURSE_FILE_MAX_TEXT_CHARS=4000000
COURSE_FILE_PROCESSING_SECONDS=120
COURSE_FILE_BATCH_SIZE=4
COURSE_FILE_QUEUE_LIMIT=100
# Both Docker projects use this repo-root .env (LMS uses --env-file .env).
# Never expose the service key to Vite/the browser.
PACEWISE_API_KEY=replace-with-a-long-random-service-key
# Reserved legacy launch secret (new simulator links use opaque one-time codes).
PACEWISE_LAUNCH_SECRET=replace-with-a-unique-random-launch-secret
# Public browser URL used in the launch link.
PACEWISE_URL=http://localhost:5173
# Production alternative: mount a secret and set only the corresponding *_FILE path.
# PACEWISE_API_KEY_FILE=/run/secrets/pacewise_api_key
# Use a unique random value (at least 32 chars); required and non-default in production.
PACEWISE_SESSION_SECRET=replace-with-a-unique-random-session-secret
# PACEWISE_SESSION_SECRET_FILE=/run/secrets/pacewise_session_secret
PACEWISE_SESSION_MINUTES=240
SESSION_COOKIE_SECURE=false
# Binary 64-byte field-encryption key, outside SQL. Development creates it once
# in persistent data; production must mount the same backed-up key in both services.
CUSTOMER_DATA_KEY_FILE=./data/customer-data.key
GOOGLE_SIGNUP_ENABLED=true
GOOGLE_SIGNUP_AUTO_ENROLL_COURSES=true
GOOGLE_SIGNUP_AUTO_ENROLL_TEACHER_EMAIL=teacher1@pacewise.edu.vn
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=600
UPLOAD_TICKET_RATE_LIMIT=10
UPLOAD_TICKET_RATE_WINDOW_SECONDS=60
LMS_SYNC_INTERVAL_SECONDS=30
WORKER_BATCH_SIZE=100
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=3
# Production: configure each source queue with its DLQ redrive policy in AWS.
SQS_INGESTION_QUEUE_URL=
SQS_INGESTION_DLQ_URL=
SQS_NOTIFICATION_QUEUE_URL=
SQS_NOTIFICATION_DLQ_URL=
SQS_WAIT_TIME_SECONDS=10
# Set true behind a TLS reverse proxy in production.
FORCE_HTTPS=false

# ---- Google Calendar (optional MVP integration) ----
# Create a Web application OAuth client in Google Cloud and register exactly:
# http://localhost:8000/api/v1/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-calendar/callback
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:5173/app#/settings

# Shared DB limiter: all outbound attempts, refresh and retries count.
# Lower these to fit YOUR Cloud quotas and usage by other API consumers.
GOOGLE_API_PROJECT_PER_MINUTE=1500
GOOGLE_API_USER_PER_MINUTE=60
GOOGLE_API_DAILY_BUDGET=50000
GOOGLE_API_MAX_CONCURRENT=16
GOOGLE_API_CACHE_SECONDS=300

# Payload privacy; HTTPS is still mandatory in production.
PRIVATE_API_REQUIRED=true
PRIVATE_API_KEY_FILE=./data/private-api-p256.pem
# All backend replicas must share this persistent secret key file. Do not commit it.

# ---- Browser Web Push (opt-in student reminders) ----
WEBPUSH_ENABLED=true
# Development creates this key once in the persistent data volume, never in Git.
# Production: mount a persistent P-256 PEM private key and use a real contact.
WEBPUSH_PRIVATE_KEY_FILE=./data/webpush-vapid.pem
WEBPUSH_SUBJECT=mailto:pacewise@example.com

# ---- Private observability / model policy ----
# Task routing for the PaceWise proxy/provider.
LLM_FAST_MODEL=cx/gpt-5.6-luna
LLM_REASONING_MODEL=cx/gpt-5.6-sol
RAG_CACHE_TTL_SECONDS=600
RAG_CACHE_MAX_ENTRIES=512
RAG_WARM_ON_STARTUP=true
LLM_MAX_CONCURRENT=8
LLM_MAX_WAITING=32
LLM_QUEUE_TIMEOUT_SECONDS=1
LLM_CACHE_TTL_SECONDS=300
LLM_CACHE_MAX_ENTRIES=256
# Shared database limits across backend processes. Same-campus users may share an IP.
AI_RATE_LIMIT_ENABLED=true
AI_IP_REQUESTS_PER_MINUTE=1000
AI_BURST_REQUESTS=3
AI_BURST_WINDOW_SECONDS=10
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_HOUR=60
# Set to 0 only in local/demo environments to disable the daily token quota.
AI_DAILY_TOKEN_LIMIT_PER_USER=2000000
AI_ESTIMATED_TOKENS_PER_REQUEST=8000
AI_MAX_CONCURRENT_PER_USER=1
AI_MAX_CONCURRENT_GLOBAL=10
AI_RESERVATION_TTL_SECONDS=600
# USD budgets are opt-in and require accurate provider prices below, not zero.
AI_DAILY_BUDGET_USD=0
AI_INSTITUTION_DAILY_BUDGET_USD=0
RAG_MIN_CANDIDATE_SCORE=0.4
# Configure pricing for honest estimated-cost metrics; defaults are unknown (0).
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
# Explicit opt-in. Metadata only; no prompts, answers, names, emails or user IDs.
LANGSMITH_ENABLED=false
# Alternatively, omit this variable to reuse an existing LANGCHAIN_API_KEY.
# An explicitly empty LANGSMITH_API_KEY does not fall back to the legacy key.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pacewise-private-metadata
# Required for organization-scoped service keys; choose an authorized workspace.
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Raw LangChain/LangGraph tracing is disabled by the application for privacy.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
# Production metrics access requires this token; keep /metrics on the private network.
METRICS_BEARER_TOKEN=

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend ----
# The Docker frontend uses the same origin and proxies /api to the backend.
VITE_API_URL=/api/v1
VITE_COURSE_SOURCE_MODE=standalone
VITE_COURSE_PDF_MAX_MB=50
# Browser-facing LMS URL used by the "Quay lại LMS" action.
VITE_LMS_URL=http://localhost:8010
