# Copy to .env.test only when local tests need overrides. CI injects these.
APP_ENV=test
DATABASE_URL=sqlite:///./data/pacewise-test.db
COURSE_SOURCE_MODE=standalone
COURSE_STORAGE_BACKEND=local
PACEWISE_SESSION_SECRET=test-session-secret-with-at-least-32-characters
SESSION_COOKIE_SECURE=false
FORCE_HTTPS=false
OPENAI_API_KEY=test-key
